{
  "name": "dsh-shixu-channel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "渠道内核：统一事件、驱动注册表、发放与收回",
  "main": "dist/channels.js",
  "types": "dist/channels.d.ts",
  "exports": {
    ".": { "types": "./dist/channels.d.ts", "default": "./dist/channels.js" },
    "./contracts": { "types": "./dist/contracts.d.ts", "default": "./dist/contracts.js" },
    "./driver-fake": { "types": "./dist/driver-fake.d.ts", "default": "./dist/driver-fake.js" },
    "./binding": { "types": "./dist/binding.d.ts", "default": "./dist/binding.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["dist", "cordis.patch.yml"],
  "scripts": { "build": "tsc -p tsconfig.json" },
  "dependencies": { "@deepseek-ai/cordis": "~4.0.5" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
