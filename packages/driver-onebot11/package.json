{
  "name": "dsh-shixu-driver-onebot11",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OneBot 11 驱动：反向 WebSocket，把协议事件归一化成统一事件",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
