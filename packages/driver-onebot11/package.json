{
  "name": "dsh-shixu-driver-onebot11",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OneBot 11 驱动：反向 WebSocket，把协议事件归一化成统一事件",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "dsh-shixu-channel": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "dsh-shixu-channel": "*"
  },
  "peerDependenciesMeta": {
    "dsh-shixu-channel": {
      "optional": true
    }
  }
}
